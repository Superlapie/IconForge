{
	"schema_version": 1,
	"preset_revision": 1,
	"id": "npc_portrait",
	"display_name": "NPC Portrait",
	"description": "Readable character portrait composition for dialogue, shops, and quest panels.",
	"tags": ["npc", "portrait", "dialogue"],
	"resolution": {"width": 256, "height": 256},
	"supersampling": 2,
	"projection": "perspective",
	"camera": {"orientation_strategy": "creature_portrait", "yaw": 12, "pitch": -2, "roll": 0, "fov": 32, "distance": 3, "occupancy": 0.8, "padding": 0.08, "auto_frame": true},
	"lighting": {"rig": "neutral_studio", "ambient_energy": 0.55},
	"environment": {"background": "gradient", "gradient_top": [0.12, 0.15, 0.24, 1], "gradient_bottom": [0.03, 0.04, 0.08, 1], "color": [0.05, 0.06, 0.1, 1]},
	"shadows": {"mode": "scene", "opacity": 0.18, "blur": 3, "offset": [0, 4]},
	"post_process": {"contrast": 1.03, "saturation": 1.02, "alpha_threshold": 0.01, "outline": {"enabled": false}},
	"composition": {"center_mode": "aabb", "vertical_bias": 0.06, "horizontal_bias": 0, "scale": 1, "rotation_order": "yxz"},
	"output": {"format": "png", "transparent": false, "name_pattern": "{source_name}_portrait.png", "overwrite": false}
}
