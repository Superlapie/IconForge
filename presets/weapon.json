{
	"schema_version": 1,
	"id": "weapon",
	"display_name": "Weapon",
	"description": "Diagonal composition tuned for elongated swords, bows, staves, and polearms.",
	"tags": ["weapon", "inventory", "diagonal", "transparent"],
	"resolution": {"width": 256, "height": 256},
	"supersampling": 2,
	"projection": "orthographic",
	"camera": {"orientation_strategy": "weapon_diagonal", "yaw": 18, "pitch": -10, "roll": 0, "occupancy": 0.84, "padding": 0.07, "auto_frame": true},
	"lighting": {"rig": "neutral_studio", "ambient_energy": 0.5},
	"environment": {"background": "transparent", "color": [0.04, 0.05, 0.08, 1]},
	"shadows": {"mode": "contact", "opacity": 0.18, "blur": 3, "offset": [0, 4]},
	"post_process": {"contrast": 1.06, "saturation": 1.04, "alpha_threshold": 0.01, "outline": {"enabled": true, "width": 2, "opacity": 0.65, "color": [0.02, 0.03, 0.07, 1]}},
	"composition": {"center_mode": "aabb", "vertical_bias": 0, "horizontal_bias": 0, "scale": 1, "rotation_order": "yxz"},
	"output": {"format": "png", "transparent": true, "name_pattern": "{source_name}.png", "overwrite": false}
}
