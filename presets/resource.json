{
	"schema_version": 1,
	"id": "resource",
	"display_name": "Resource",
	"description": "Close framing with a strong silhouette for ore, herbs, gems, and crafting materials.",
	"tags": ["resource", "crafting", "close", "transparent"],
	"resolution": {"width": 256, "height": 256},
	"supersampling": 2,
	"projection": "orthographic",
	"camera": {"orientation_strategy": "longest_axis_diagonal", "yaw": 28, "pitch": -12, "roll": 0, "occupancy": 0.86, "padding": 0.06, "auto_frame": true},
	"lighting": {"rig": "cold_magic", "ambient_energy": 0.42},
	"environment": {"background": "transparent", "color": [0.04, 0.05, 0.08, 1]},
	"shadows": {"mode": "contact", "opacity": 0.22, "blur": 3, "offset": [0, 4]},
	"post_process": {"contrast": 1.08, "saturation": 1.1, "alpha_threshold": 0.01, "bloom": 0.08, "outline": {"enabled": true, "width": 2, "opacity": 0.55, "color": [0.04, 0.08, 0.16, 1]}},
	"composition": {"center_mode": "aabb", "vertical_bias": 0, "horizontal_bias": 0, "scale": 1, "rotation_order": "yxz"},
	"output": {"format": "png", "transparent": true, "name_pattern": "{source_name}.png", "overwrite": false}
}
