{
	"schema_version": 1,
	"id": "shop_thumbnail",
	"display_name": "Shop Thumbnail",
	"description": "Small-format high-readability render for shop grids and buy lists.",
	"tags": ["shop", "thumbnail", "readability", "transparent"],
	"resolution": {"width": 128, "height": 128},
	"supersampling": 3,
	"projection": "orthographic",
	"camera": {"orientation_strategy": "preserve", "yaw": 22, "pitch": -9, "roll": 0, "occupancy": 0.8, "padding": 0.1, "auto_frame": true},
	"lighting": {"rig": "flat_ui", "ambient_energy": 0.65},
	"environment": {"background": "transparent", "color": [0.04, 0.05, 0.08, 1]},
	"shadows": {"mode": "contact", "opacity": 0.15, "blur": 2, "offset": [0, 2]},
	"post_process": {"contrast": 1.08, "saturation": 1.04, "alpha_threshold": 0.02, "outline": {"enabled": true, "width": 2, "opacity": 0.7, "color": [0.02, 0.03, 0.06, 1]}},
	"composition": {"center_mode": "aabb", "vertical_bias": 0, "horizontal_bias": 0, "scale": 1, "rotation_order": "yxz"},
	"output": {"format": "png", "transparent": true, "name_pattern": "{source_name}.png", "overwrite": false}
}
