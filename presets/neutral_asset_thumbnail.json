{
	"schema_version": 1,
	"preset_revision": 1,
	"id": "neutral_asset_thumbnail",
	"display_name": "Neutral Asset Thumbnail",
	"description": "Safe general-purpose thumbnail for asset browsers and batch smoke tests.",
	"tags": ["neutral", "asset-browser", "thumbnail", "transparent"],
	"resolution": {"width": 256, "height": 256},
	"supersampling": 2,
	"projection": "orthographic",
	"camera": {"orientation_strategy": "preserve", "yaw": 18, "pitch": -8, "roll": 0, "occupancy": 0.8, "padding": 0.09, "auto_frame": true},
	"lighting": {"rig": "neutral_studio", "ambient_energy": 0.5},
	"environment": {"background": "transparent", "color": [0.04, 0.05, 0.08, 1]},
	"shadows": {"mode": "contact", "opacity": 0.18, "blur": 3, "offset": [0, 4]},
	"post_process": {"contrast": 1.03, "saturation": 1.02, "alpha_threshold": 0.01, "outline": {"enabled": false}},
	"composition": {"center_mode": "aabb", "vertical_bias": 0, "horizontal_bias": 0, "scale": 1, "rotation_order": "yxz"},
	"output": {"format": "png", "transparent": true, "name_pattern": "{source_name}.png", "overwrite": false}
}
