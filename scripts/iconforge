#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
runtime_error_json() {
	local message="$1"
	python3 - "$message" <<'PY'
import json, sys
print(json.dumps({
    "success": False,
    "status": "failed",
    "code": "RUNTIME_START_FAILED",
    "message": sys.argv[1],
    "recommended_action": "check_runtime_installation",
}))
PY
}

if [[ -n "${ICONFORGE_GODOT:-}" ]]; then
	GODOT_BIN="$ICONFORGE_GODOT"
elif [[ -n "${ICONSTUDIO_GODOT:-}" ]]; then
	GODOT_BIN="$ICONSTUDIO_GODOT"
elif [[ -x "$ROOT/.tools/godot/Godot_v4.7.2-stable_linux.x86_64" ]]; then
	GODOT_BIN="$ROOT/.tools/godot/Godot_v4.7.2-stable_linux.x86_64"
elif command -v godot >/dev/null 2>&1; then
	GODOT_BIN="$(command -v godot)"
elif command -v godot4 >/dev/null 2>&1; then
	GODOT_BIN="$(command -v godot4)"
else
	if [[ " $* " == *" --json "* ]]; then
		runtime_error_json "ICONFORGE_GODOT_NOT_FOUND: install Godot 4.x or set ICONFORGE_GODOT"
	else
		echo "ICONFORGE_GODOT_NOT_FOUND: install Godot 4.x or set ICONFORGE_GODOT" >&2
	fi
	exit 127
fi

cd "$ROOT"

# Service transport: stdout must contain only JSON-lines (no Godot banner).
_filter_service_stdout() {
	python3 -c '
import json, sys
for raw in sys.stdin:
    line = raw.rstrip("\r\n")
    if not line.strip():
        continue
    try:
        json.loads(line)
    except json.JSONDecodeError:
        print(line, file=sys.stderr, flush=True)
        continue
    print(line, flush=True)
'
}

if [[ "${1:-}" == "service" ]]; then
	if ! "$ROOT/scripts/godot-runtime" bootstrap; then
		echo "Godot project bootstrap failed. Run ./scripts/godot-runtime bootstrap." >&2
		exit 127
	fi
	_run_service() {
		if command -v xvfb-run >/dev/null 2>&1; then
			xvfb-run -a "$GODOT_BIN" --path "$ROOT" --display-driver x11 --rendering-method gl_compatibility --audio-driver Dummy --disable-vsync -- --cli "$@" 2>&1
		else
			"$GODOT_BIN" --headless --path "$ROOT" --rendering-method gl_compatibility --audio-driver Dummy -- --cli "$@" 2>&1
		fi
	}
	_run_service service "${@:2}" | _filter_service_stdout
	exit "${PIPESTATUS[0]}"
fi

if ! "$ROOT/scripts/godot-runtime" bootstrap; then
	if [[ " $* " == *" --json "* ]]; then
		runtime_error_json "Godot project bootstrap failed. Run ./scripts/godot-runtime bootstrap."
	else
		echo "Godot project bootstrap failed. Run ./scripts/godot-runtime bootstrap." >&2
	fi
	exit 127
fi
if [[ " $* " == *" --json "* ]]; then
	stderr_file="$(mktemp)"
	stdout_file="$(mktemp)"
	set +e
	if command -v xvfb-run >/dev/null 2>&1; then
		xvfb-run -a "$GODOT_BIN" --path "$ROOT" --display-driver x11 --rendering-method gl_compatibility --audio-driver Dummy --disable-vsync -- --cli "$@" 2>"$stderr_file" | awk '/^\{/{print}' >"$stdout_file"
		status=${PIPESTATUS[0]}
	else
		"$GODOT_BIN" --headless --path "$ROOT" --rendering-method gl_compatibility --audio-driver Dummy -- --cli "$@" 2>"$stderr_file" | awk '/^\{/{print}' >"$stdout_file"
		status=${PIPESTATUS[0]}
	fi
	set -e
	stdout="$(cat "$stdout_file")"
	rm -f "$stdout_file"
	if [[ -z "${stdout// }" ]]; then
		stderr_text="$(tr '\n' ' ' <"$stderr_file" | head -c 500)"
		rm -f "$stderr_file"
		if [[ -z "$stderr_text" ]]; then
			stderr_text="Icon Forge produced no JSON response (exit ${status:-1})."
		fi
		runtime_error_json "$stderr_text"
		exit "${status:-1}"
	fi
	rm -f "$stderr_file"
	printf '%s\n' "$stdout"
	exit "$status"
fi
if command -v xvfb-run >/dev/null 2>&1; then
	exec xvfb-run -a "$GODOT_BIN" --path "$ROOT" --display-driver x11 --rendering-method gl_compatibility --audio-driver Dummy --disable-vsync -- --cli "$@"
fi
exec "$GODOT_BIN" --headless --path "$ROOT" --rendering-method gl_compatibility --audio-driver Dummy -- --cli "$@"
