#!/usr/bin/env bash
set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CLI="$ROOT/scripts/iconforge"
failed=0

echo "Icon Forge quality gate"
echo "========================"

if "$CLI" --test; then
	:
else
	failed=1
	echo "FAIL  automated Godot tests"
fi

mkdir -p "$ROOT/out"

API_CAPABILITIES="$ROOT/out/quality_api_capabilities.json"
API_RENDER="$ROOT/out/quality_api_render.json"
API_PORTRAIT="$ROOT/out/quality_api_portrait.json"
API_CACHE="$ROOT/out/quality_api_cache.json"
printf '%s\n' '{"schema_version":1,"operation":"capabilities"}' >"$API_CAPABILITIES"
printf '%s\n' '{"schema_version":1,"operation":"render_asset","asset":"fixtures/sword.gltf","purpose":"inventory_icon","force":true}' >"$API_RENDER"
printf '%s\n' '{"schema_version":1,"operation":"render_asset","asset":"fixtures/sword.gltf","purpose":"npc_portrait","force":true}' >"$API_PORTRAIT"
printf '%s\n' '{"schema_version":1,"operation":"render_asset","asset":"fixtures/sword.gltf","purpose":"shop_thumbnail"}' >"$API_CACHE"

if "$CLI" api --request "$API_CAPABILITIES" --json >/dev/null; then
	:
else
	failed=1
	echo "FAIL  machine API capabilities"
fi

if "$CLI" api --request "$API_RENDER" --json >/dev/null; then
	:
else
	failed=1
	echo "FAIL  machine API render_asset"
fi

if "$CLI" api --request "$API_PORTRAIT" --json >/dev/null; then
	:
else
	failed=1
	echo "FAIL  machine API portrait purpose"
fi

if "$CLI" api --request "$API_CACHE" --json >/dev/null; then
	if "$CLI" api --request "$API_CACHE" --json | grep -q '"cache_hit":true'; then
		:
	else
		failed=1
		echo "FAIL  machine API cache hit"
	fi
else
	failed=1
	echo "FAIL  machine API cache render"
fi

if "$ROOT/scripts/client-e2e"; then
	:
else
	failed=1
	echo "FAIL  official Enigma client E2E"
fi

if "$ROOT/scripts/lock-e2e"; then
	:
else
	failed=1
	echo "FAIL  cross-process output lock"
fi

for preset in "$ROOT"/presets/*.json; do
	if "$CLI" validate-preset "$preset" --json >/dev/null; then
		:
	else
		failed=1
		echo "FAIL  preset validation: $preset"
	fi
done

if "$CLI" render fixtures/sword.gltf --preset weapon --output out/quality_sword.png --force --json; then
	:
else
	failed=1
	echo "FAIL  single fixture render"
fi

if "$CLI" validate-output out/quality_sword.png --preset weapon --json; then
	:
else
	failed=1
	echo "FAIL  output quality validation"
fi

if "$CLI" render-batch fixtures --preset neutral_asset_thumbnail --output out/quality_batch --force --manifest out/quality_batch/manifest.json --json; then
	:
else
	failed=1
	echo "FAIL  batch render smoke test"
fi

if "$ROOT/scripts/real-model-e2e"; then
	:
else
	failed=1
	echo "FAIL  real-model E2E"
fi

if "$ROOT/scripts/gui-e2e"; then
	:
else
	failed=1
	echo "FAIL  GUI drag/drop E2E"
fi

if "$ROOT/scripts/gui-interaction-e2e"; then
	:
else
	failed=1
	echo "FAIL  GUI interaction E2E"
fi

if [[ "$failed" -eq 0 ]]; then
	echo "PASS  all quality gates"
	exit 0
fi

echo "FAIL  one or more quality gates failed"
exit 1
